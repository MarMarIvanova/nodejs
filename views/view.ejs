<%- include('partials/header', { title: book.title || 'View Book' }) %>
    <div class="container py-5">
        <div class="card">
            <div class="card-body">
                <div class="border-bottom pb-3 mb-4">
                    <h2 class="card-title"><%= book.title || 'No title' %></h2>
                    <% if (book.authors) { %>
                        <p class="text-muted mb-2">Author: <%= book.authors %></p>
                    <% } %>
                    <% if (book.favorite) { %>
                        <span class="badge bg-warning text-dark">Favorite</span>
                    <% } %>
                </div>

                <div class="mb-3">
                    <h6 class="text-uppercase text-muted small">Description</h6>
                    <p><%= book.description || 'No description' %></p>
                </div>

                <% if (book.fileCover) { %>
                    <div class="mb-3">
                        <h6 class="text-uppercase text-muted small">Cover</h6>
                        <p><%= book.fileCover %></p>
                    </div>
                <% } %>

                <% if (book.fileName) { %>
                    <div class="mb-3">
                        <h6 class="text-uppercase text-muted small">File Name</h6>
                        <p><%= book.fileName %></p>
                    </div>
                <% } %>

                <div class="border-top pt-3 mt-4">
                    <a href="/books" class="btn btn-primary me-2">← Back to List</a>
                    <a href="/books/<%= book.id %>/update" class="btn btn-primary me-2">Edit</a>
                    <% if (book.fileBook) { %>
                        <a href="/api/books/<%= book.id %>/download" class="btn btn-primary me-2">Download Book</a>
                    <% } %>
                    <form action="/books/<%= book.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this book?');">
                        <button type="submit" class="btn btn-primary">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
<%- include('partials/footer') %>
