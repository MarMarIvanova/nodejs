<%- include('partials/header', { title: book.title || 'View Book' }) %>
    <div class="container py-5">
        <div class="card">
            <div class="card-body">
                <div class="border-bottom pb-3 mb-4">
                    <h2 class="card-title"><%= book.title || 'No title' %></h2>
                    <% if (book.authors) { %>
                        <p class="text-muted mb-2">Author: <%= book.authors %></p>
                    <% } %>
                    <% if (book.favorite) { %>
                        <span class="badge bg-warning text-dark">Favorite</span>
                    <% } %>
                    <p class="text-muted mb-0 mt-2">Views: <%= typeof viewCount !== 'undefined' ? viewCount : 0 %></p>
                </div>

                <div class="mb-3">
                    <h6 class="text-uppercase text-muted small">Description</h6>
                    <p><%= book.description || 'No description' %></p>
                </div>

                <% if (book.fileCover) { %>
                    <div class="mb-3">
                        <h6 class="text-uppercase text-muted small">Cover</h6>
                        <p><%= book.fileCover %></p>
                    </div>
                <% } %>

                <% if (book.fileName) { %>
                    <div class="mb-3">
                        <h6 class="text-uppercase text-muted small">File Name</h6>
                        <p><%= book.fileName %></p>
                    </div>
                <% } %>

                <div class="border-top pt-3 mt-4">
                    <a href="/books" class="btn btn-primary me-2">← Back to List</a>
                    <a href="/books/<%= book.id %>/update" class="btn btn-primary me-2">Edit</a>
                    <% if (book.fileBook) { %>
                        <a href="/api/books/<%= book.id %>/download" class="btn btn-primary me-2">Download Book</a>
                    <% } %>
                    <form action="/books/<%= book.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this book?');">
                        <button type="submit" class="btn btn-primary">Delete</button>
                    </form>
                </div>

                <hr class="my-4" />
                <h6 class="text-uppercase text-muted small mb-3">Discussion</h6>
                <div id="comments-list" class="list-group list-group-flush mb-3" style="max-height: 300px; overflow-y: auto;"></div>
                <div class="mt-3">
                    <div class="mb-2">
                        <label for="comment-username" class="form-label small">Your name</label>
                        <input type="text" class="form-control form-control-sm" id="comment-username" placeholder="Username" value="<%= typeof user !== 'undefined' && user && user.username ? user.username : '' %>" />
                    </div>
                    <div class="mb-2">
                        <label for="comment-text" class="form-label small">Comment</label>
                        <textarea class="form-control form-control-sm" id="comment-text" rows="2" placeholder="Write a comment..."></textarea>
                    </div>
                    <button type="button" id="comment-send" class="btn btn-primary btn-sm">Send</button>
                </div>
            </div>
        </div>
    </div>
<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
    const bookId = '<%= book.id %>';
    const socket = io({ query: { roomName: bookId } });
    const listEl = document.getElementById('comments-list');
    const inputName = document.getElementById('comment-username');
    const inputText = document.getElementById('comment-text');
    const sendBtn = document.getElementById('comment-send');

    function addCommentToUI(comment) {
        const time = comment.createdAt ? new Date(comment.createdAt).toLocaleString() : '';
        const html = `
            <div class="list-group-item list-group-item-action py-2">
                <div class="d-flex w-100 justify-content-between">
                    <small class="fw-semibold">${escapeHtml(comment.username)}</small>
                    <small class="text-muted">${escapeHtml(time)}</small>
                </div>
                <p class="mb-0 small">${escapeHtml(comment.text)}</p>
            </div>`;
        listEl.insertAdjacentHTML('beforeend', html);
        listEl.scrollTop = listEl.scrollHeight;
    }

    function escapeHtml(s) {
        if (!s) return '';
        const div = document.createElement('div');
        div.textContent = s;
        return div.innerHTML;
    }

    socket.on('comments-history', (comments) => {
        (comments || []).forEach(addCommentToUI);
    });

    socket.on('comment', addCommentToUI);

    sendBtn.addEventListener('click', () => {
        const username = (inputName.value || '').trim() || 'Anonymous';
        const text = (inputText.value || '').trim();
        if (!text) return;
        socket.emit('comment', { username, text });
        inputText.value = '';
    });
})();
</script>
<%- include('partials/footer') %>
