<%- include('partials/header', { title: 'Home' }) %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body text-center py-5">
          <% if (!user) { %>
            <h1 class="card-title h4 mb-4">Home</h1>
            <p class="text-muted mb-4">Please sign in to continue.</p>
            <a href="/login" class="btn btn-primary btn-lg">Login</a>
            <hr class="my-4" />
            <a href="/signup" class="text-muted small">Don't have an account? Register</a>
          <% } else { %>
            <h1 class="card-title h4 mb-4">Hello, <%= user.username %>!</h1>
            <p class="text-muted mb-4">Welcome to the Book Library.</p>
            <div class="d-grid gap-2">
              <a href="/api/user/me" class="btn btn-primary">Profile</a>
              <a href="/books" class="btn btn-outline-primary">To the list of books</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
