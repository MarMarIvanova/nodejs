<%- include('partials/header', { title: 'Book List' }) %>
    <div class="container py-5">
        <h1 class="text-center mb-4">Book Library</h1>
        <div class="mb-4">
            <a href="/books/create" class="btn btn-primary">+ Add New Book</a>
        </div>
        
        <% if (books && books.length > 0) { %>
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% books.forEach(book => { %>
                                <tr>
                                    <td><%= book.title || 'No title' %></td>
                                    <td><%= book.authors || '-' %></td>
                                    <td>
                                        <a href="/books/<%= book.id %>" class="btn btn-primary btn-sm me-2">View</a>
                                        <a href="/books/<%= book.id %>/update" class="btn btn-primary btn-sm">Edit</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } else { %>
            <div class="card">
                <div class="card-body text-center py-5">
                    <h2 class="card-title">No books yet</h2>
                    <p class="card-text">Add the first book to the library!</p>
                </div>
            </div>
        <% } %>
    </div>
<%- include('partials/footer') %>
